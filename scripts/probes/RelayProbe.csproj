<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InputTransformTrial)' == 'true'">
    <ApplicationManifest>../../src/Magnifier.App/app.uiaccess.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <DefineConstants>$(DefineConstants);INPUT_TRANSFORM_TRIAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Magnifier.Core">
      <HintPath>../../src/Magnifier.Core/bin/Debug/net9.0/Magnifier.Core.dll</HintPath>
    </Reference>
    <Reference Include="Magnifier.Infrastructure">
      <HintPath>../../src/Magnifier.Infrastructure/bin/Debug/net9.0-windows/Magnifier.Infrastructure.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
