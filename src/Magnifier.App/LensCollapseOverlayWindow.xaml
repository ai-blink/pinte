<Window x:Class="Magnifier.App.LensCollapseOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="렌즈 펼치기" Width="52" Height="52" MinWidth="52" MinHeight="52"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Border Margin="2" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
            BorderThickness="2" CornerRadius="24">
        <Button x:Name="ExpandButton" Style="{StaticResource IconButtonStyle}" BorderThickness="0" Background="Transparent"
                Content="⌕" FontSize="25" Cursor="SizeAll" Click="ExpandButton_OnClick"
                PreviewMouseLeftButtonDown="ExpandButton_OnPreviewMouseLeftButtonDown"
                PreviewMouseMove="ExpandButton_OnPreviewMouseMove"
                PreviewMouseLeftButtonUp="ExpandButton_OnPreviewMouseLeftButtonUp"
                LostMouseCapture="ExpandButton_OnLostMouseCapture"
                ToolTip="클릭하여 렌즈 다시 펼치기 · 드래그하여 아이콘 이동"
                AutomationProperties.Name="렌즈 다시 펼치기 또는 아이콘 이동" />
    </Border>
</Window>
