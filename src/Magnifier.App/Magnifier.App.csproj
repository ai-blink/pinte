<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Pinte.ico</ApplicationIcon>
    <VersionPrefix>0.2.0</VersionPrefix>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(InputTransformTrial)' == 'true'">
    <ApplicationManifest>app.uiaccess.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);INPUT_TRANSFORM_TRIAL</DefineConstants>
  </PropertyGroup>

  <!-- WPF needs native runtime libraries during window-hook initialization. Keep every
       single-file Windows publish self-extracting so the release executable is runnable. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Pinte.png" />
    <ProjectReference Include="..\Magnifier.Core\Magnifier.Core.csproj" />
    <ProjectReference Include="..\Magnifier.Infrastructure\Magnifier.Infrastructure.csproj" />
  </ItemGroup>

</Project>
