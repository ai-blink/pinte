<Window x:Class="Magnifier.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Magnifier.App"
        mc:Ignorable="d"
        Title="Magnifier"
        Width="720"
        Height="500"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Magnifier"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="#182235" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="18"
                       Foreground="#40516A"
                       Text="화면의 필요한 부분을 크게 보며 다음 동작을 준비합니다." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,28,0,28"
                Padding="28"
                Background="#F2F6FB"
                BorderBrush="#CBD7E6"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <TextBlock Text="1. 작업할 영역을 고르세요"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#182235" />
                <TextBlock Margin="0,10,0,22"
                           FontSize="16"
                           Foreground="#40516A"
                           TextWrapping="Wrap"
                           Text="영역 선택 뒤 마우스로 드래그하면, 선택 결과가 별도 미리보기 창에 표시됩니다." />
                <Button x:Name="SelectRegionButton"
                        Width="240"
                        Height="72"
                        HorizontalAlignment="Left"
                        Background="#1769E0"
                        BorderThickness="0"
                        Click="SelectRegionButton_OnClick"
                        Content="영역 선택"
                        FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="White" />
                <CheckBox x:Name="InputEnabledCheckBox"
                          Margin="0,22,0,0"
                          Checked="InputEnabledCheckBox_OnChanged"
                          Unchecked="InputEnabledCheckBox_OnChanged"
                          Content="A→B 실제 입력 허용"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="#182235" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="#5A6B84"
                           TextWrapping="Wrap"
                           Text="기본값은 꺼짐입니다. A/B 표식과 선은 항상 확인할 수 있고, 켜면 실제 A→B 실행만 원본 화면에 전달됩니다." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="SelectionStatusText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#182235"
                       Text="선택한 영역 없음" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="14"
                       Foreground="#5A6B84"
                       Text="화면 캡처는 연결됨 · 실제 포인터 입력은 기본적으로 꺼짐" />
        </StackPanel>
    </Grid>
</Window>
