<Window x:Class="Magnifier.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magnifier" Width="410" Height="290" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <StackPanel Margin="24">
        <TextBlock Text="필요한 곳을 크게" FontSize="26" FontWeight="SemiBold" Foreground="#182235" />
        <TextBlock Margin="0,8,0,18" Text="테두리로 영역을 정하고, 렌즈에서 조작하세요."
                   TextWrapping="Wrap" FontSize="15" Foreground="#40516A" />
        <Button x:Name="SelectRegionButton" Content="확대 시작" Height="64" FontSize="23"
                Foreground="White" Background="#1769E0" Click="SelectRegionButton_OnClick" />
        <TextBlock x:Name="SelectionStatusText" Margin="0,16,0,0" FontSize="14" Foreground="#40516A"
                   TextWrapping="Wrap" Text="시작은 보기 모드입니다. 조작은 렌즈에서 켭니다." />
    </StackPanel>
</Window>
