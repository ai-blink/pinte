<Window x:Class="Magnifier.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Magnifier.App.Localization"
        Title="Pinte" Width="430" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppSurfaceBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="24">
        <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0" SnapsToDevicePixels="True">
                        <Image Source="/Assets/Pinte.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PINTE" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" />
                        <TextBlock Text="{loc:Tr MainWindow_Tagline}" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="15" LineHeight="22"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Text="{loc:Tr MainWindow_Description}" />
                <Button x:Name="SelectRegionButton" Style="{StaticResource AccentButtonStyle}" Height="56" FontSize="17" Margin="0,24,0,0"
                        Content="{loc:Tr MainWindow_SelectRegionButton}" Click="SelectRegionButton_OnClick" />
                <TextBlock x:Name="SelectionStatusText" Margin="0,14,0,0" FontSize="12"
                           Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"
                           Text="{loc:Tr MainWindow_Status_Idle}" />            </StackPanel>
        </Border>
    </Grid>
</Window>
