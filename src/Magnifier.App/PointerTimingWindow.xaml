<Window x:Class="Magnifier.App.PointerTimingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Magnifier.App.Localization"
        Title="{loc:Tr Timing_WindowTitle}" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual"
        Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}">
    <Border Margin="10" Padding="14" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <StackPanel>
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:Tr Timing_PanelTitle}" />
            <TextBlock Margin="0,4,0,10" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                       Text="{loc:Tr Timing_PanelHint}" />
            <StackPanel x:Name="Rows" />
            <TextBlock Margin="0,10,0,4" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" Text="{loc:Tr Timing_PresetsHeader}" />
            <UniformGrid x:Name="PresetButtons" Rows="1" />
            <TextBlock Margin="0,10,0,4" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" Text="{loc:Tr Timing_ABHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ApplyAButton" Grid.Column="0" Style="{StaticResource AppButtonStyle}" Height="34" Margin="0,0,3,0" Click="ApplyA_OnClick" />
                <Button x:Name="ApplyBButton" Grid.Column="1" Style="{StaticResource AppButtonStyle}" Height="34" Margin="3,0,3,0" Click="ApplyB_OnClick" />
                <Button Grid.Column="2" Style="{StaticResource AppButtonStyle}" Height="34" Margin="3,0,3,0" Content="{loc:Tr Timing_SaveA_Content}" Click="SaveA_OnClick" />
                <Button Grid.Column="3" Style="{StaticResource AppButtonStyle}" Height="34" Margin="3,0,0,0" Content="{loc:Tr Timing_SaveB_Content}" Click="SaveB_OnClick" />
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ApplyButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" Height="40" Margin="0,0,3,0"
                        Content="{loc:Tr Timing_Apply_Content}" Click="Apply_OnClick" />
                <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource AppButtonStyle}" Height="40" Margin="3,0,3,0"
                        Content="{loc:Tr Timing_Previous_Content}" Click="Previous_OnClick" />
                <Button Grid.Column="2" Style="{StaticResource AppButtonStyle}" Height="40" Margin="3,0,0,0"
                        Content="{loc:Tr Timing_Default_Content}" Click="Default_OnClick" />
            </Grid>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
