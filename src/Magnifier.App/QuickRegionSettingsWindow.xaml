<Window x:Class="Magnifier.App.QuickRegionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Magnifier.App.Localization"
        Title="{loc:Tr QuickRegion_Title}" Width="410" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        PreviewKeyDown="QuickRegionSettingsWindow_OnPreviewKeyDown"
        Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="14">
        <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="20">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="36" MinWidth="36" MinHeight="36"
                            Content="×" Click="Close_OnClick" ToolTip="{loc:Tr QuickRegion_Close_Tooltip}"
                            AutomationProperties.Name="{loc:Tr QuickRegion_Close_Automation}" />
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{loc:Tr QuickRegion_Title}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12"
                                   Text="{loc:Tr QuickRegion_Subtitle}" />
                    </StackPanel>
                </DockPanel>
                <Border Margin="0,14,0,18" Padding="12" CornerRadius="9" Background="{DynamicResource AppCanvasBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="CurrentSizeText" Foreground="{DynamicResource AppMutedTextBrush}" />
                </Border>
                <TextBlock FontWeight="SemiBold" Text="{loc:Tr QuickRegion_SizeLabel}" />
                <ComboBox x:Name="PresetBox" Style="{StaticResource AppComboBoxStyle}" Margin="0,7,0,18" MinHeight="42"
                          SelectionChanged="PresetBox_OnSelectionChanged" AutomationProperties.Name="{loc:Tr QuickRegion_PresetBox_Automation}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource AppComboBoxItemStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="ToolTip" Value="{loc:Tr QuickRegion_PresetUnavailable_Tooltip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock FontWeight="SemiBold" Text="{loc:Tr QuickRegion_RatioLabel}" />
                <ComboBox x:Name="RatioBox" Style="{StaticResource AppComboBoxStyle}" Margin="0,7,0,10" MinHeight="42"
                          SelectionChanged="RatioBox_OnSelectionChanged" AutomationProperties.Name="{loc:Tr QuickRegion_RatioBox_Automation}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,0" Margin="0,0,8,0">
                        <CheckBox x:Name="LockBox" MinHeight="40" VerticalContentAlignment="Center"
                                  Content="{loc:Tr QuickRegion_LockRatio_Content}" Checked="LockBox_OnChanged" Unchecked="LockBox_OnChanged"
                                  AutomationProperties.Name="{loc:Tr QuickRegion_LockRatio_Automation}" />
                    </Border>
                    <Button x:Name="DirectionButton" Grid.Column="1" Click="DirectionButton_OnClick"
                            ToolTip="{loc:Tr QuickRegion_Direction_Tooltip}" AutomationProperties.Name="{loc:Tr QuickRegion_Direction_Automation}" />
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" LineHeight="18"
                           Text="{loc:Tr QuickRegion_Footnote}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
