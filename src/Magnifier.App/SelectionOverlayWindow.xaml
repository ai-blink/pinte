<Window x:Class="Magnifier.App.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="확대할 원본 영역"
        Width="420" Height="310" MinWidth="230" MinHeight="150"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ResizeHandle" TargetType="Thumb">
            <Setter Property="Background" Value="#FAEEB855" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#FF392B11" BorderThickness="1" CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="DragStarted" Handler="Handle_OnDragStarted" />
            <EventSetter Event="DragDelta" Handler="ResizeHandle_OnDragDelta" />
            <EventSetter Event="DragCompleted" Handler="Handle_OnDragCompleted" />
        </Style>
    </Window.Resources>
    <!-- Only the opaque frame and controls intercept the pointer. The fully transparent
         aperture is neither painted nor hit-testable, so the source application stays visible. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" Background="#FF312B20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Thumb x:Name="MoveHandle" Cursor="SizeAll"
                   DragStarted="Handle_OnDragStarted" DragDelta="MoveHandle_OnDragDelta"
                   DragCompleted="Handle_OnDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#FF312B20" Padding="12,0">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#FFFFDB92" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Text="✥ 원본 영역 이동" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Button x:Name="ConfirmRegionButton" Grid.Column="1" Margin="2,4" Padding="8,0" FontSize="14"
                    Visibility="Collapsed" Background="#FF1769E0" Foreground="White"
                    Content="이 영역 확대" Click="ConfirmRegionButton_OnClick" />
            <Button Grid.Column="2" Margin="2,4,5,4" FontSize="14"
                    Background="#FFFFDC8C" Foreground="#FF24201A"
                    Content="원래 화면" Click="ReturnButton_OnClick" />
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Margin="-3"
                BorderBrush="#FFF3C767" BorderThickness="3" IsHitTestVisible="False" />
        <Border x:Name="ContentAperture" Grid.Row="2" Grid.Column="1"
                Background="{x:Null}" IsHitTestVisible="False" />

        <Thumb x:Name="NorthWestHandle" Grid.Row="1" Grid.Column="0" Tag="NW" Cursor="SizeNWSE" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="NorthHandle" Grid.Row="1" Grid.Column="1" Tag="N" Cursor="SizeNS" Width="48"
               HorizontalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="NorthEastHandle" Grid.Row="1" Grid.Column="2" Tag="NE" Cursor="SizeNESW" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="WestHandle" Grid.Row="2" Grid.Column="0" Tag="W" Cursor="SizeWE" Height="48"
               VerticalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="EastHandle" Grid.Row="2" Grid.Column="2" Tag="E" Cursor="SizeWE" Height="48"
               VerticalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="SouthWestHandle" Grid.Row="3" Grid.Column="0" Tag="SW" Cursor="SizeNESW" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="SouthHandle" Grid.Row="3" Grid.Column="1" Tag="S" Cursor="SizeNS" Width="48"
               HorizontalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="SouthEastHandle" Grid.Row="3" Grid.Column="2" Tag="SE" Cursor="SizeNWSE" Style="{StaticResource ResizeHandle}" />
    </Grid>
</Window>
