<Window x:Class="Magnifier.App.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="영역 선택"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid x:Name="OverlaySurface"
          Background="#9B0B1728"
          MouseLeftButtonDown="OverlaySurface_OnMouseLeftButtonDown"
          MouseLeftButtonUp="OverlaySurface_OnMouseLeftButtonUp"
          MouseMove="OverlaySurface_OnMouseMove"
          LostMouseCapture="OverlaySurface_OnLostMouseCapture">
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Fill="#355BA7FF"
                       Stroke="#F7FBFF"
                       StrokeThickness="2" />
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="24"
                Padding="18,12"
                Background="#E91B2B42"
                BorderBrush="#B8D5FF"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="확대할 영역을 드래그하세요" />
                <TextBlock x:Name="HintText"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           Foreground="#DCEBFF"
                           Text="Esc를 누르면 취소합니다" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
