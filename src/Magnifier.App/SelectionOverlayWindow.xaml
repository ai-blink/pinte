<Window x:Class="Magnifier.App.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="확대할 원본 영역"
        Width="420" Height="310" MinWidth="230" MinHeight="150"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ResizeHandle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border Width="18" Height="18" Background="{DynamicResource AppPanelBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="3" CornerRadius="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="DragStarted" Handler="Handle_OnDragStarted" />
            <EventSetter Event="DragDelta" Handler="ResizeHandle_OnDragDelta" />
            <EventSetter Event="DragCompleted" Handler="Handle_OnDragCompleted" />
        </Style>
    </Window.Resources>
    <!-- The aperture remains transparent and click-through; only the frame chrome consumes input. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Margin="12,0,12,0" Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10,10,6,6">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Thumb x:Name="MoveHandle" Cursor="SizeAll"
                       DragStarted="Handle_OnDragStarted" DragDelta="MoveHandle_OnDragDelta"
                       DragCompleted="Handle_OnDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" Padding="10,0" CornerRadius="7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⠿" FontSize="18" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,7,0" />
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource AppTextBrush}" FontSize="12" FontWeight="SemiBold" Text="원본 영역" />
                                        <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10" Text="끌어서 이동" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Button x:Name="ConfirmRegionButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" MinHeight="40" Margin="2,0"
                        Visibility="Collapsed" Content="이 영역 확대" Click="ConfirmRegionButton_OnClick" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="40" MinWidth="40" MinHeight="40" Margin="2,0"
                        ToolTip="원본 크기와 비율" AutomationProperties.Name="원본 크기와 비율"
                        Content="크기" FontSize="12" Click="RegionSettingsButton_OnClick" />
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="40" MinWidth="40" MinHeight="40" Margin="2,0"
                        ToolTip="앱 설정" AutomationProperties.Name="앱 설정"
                        Content="⚙" Click="AppSettingsButton_OnClick" />
                <Button Grid.Column="4" Style="{StaticResource SoftAccentButtonStyle}" MinHeight="40" Margin="2,0"
                        Content="↩ 원래 화면" Click="ReturnButton_OnClick" />
                <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Width="40" MinWidth="40" MinHeight="40" Margin="2,0"
                        Content="×" Click="CloseButton_OnClick" ToolTip="확대를 끝내고 원래 화면으로"
                        AutomationProperties.Name="확대를 끝내고 원래 화면으로" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Margin="-2" BorderBrush="{DynamicResource AppAccentBrush}"
                BorderThickness="3" CornerRadius="6" IsHitTestVisible="False" />
        <Border x:Name="ContentAperture" Grid.Row="2" Grid.Column="1"
                Background="{x:Null}" IsHitTestVisible="False" />

        <Thumb x:Name="NorthWestHandle" Grid.Row="1" Grid.Column="0" Tag="NW" Cursor="SizeNWSE" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="NorthHandle" Grid.Row="1" Grid.Column="1" Tag="N" Cursor="SizeNS" Width="48"
               HorizontalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="NorthEastHandle" Grid.Row="1" Grid.Column="2" Tag="NE" Cursor="SizeNESW" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="WestHandle" Grid.Row="2" Grid.Column="0" Tag="W" Cursor="SizeWE" Height="48"
               VerticalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="EastHandle" Grid.Row="2" Grid.Column="2" Tag="E" Cursor="SizeWE" Height="48"
               VerticalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="SouthWestHandle" Grid.Row="3" Grid.Column="0" Tag="SW" Cursor="SizeNESW" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="SouthHandle" Grid.Row="3" Grid.Column="1" Tag="S" Cursor="SizeNS" Width="48"
               HorizontalAlignment="Center" Style="{StaticResource ResizeHandle}" />
        <Thumb x:Name="SouthEastHandle" Grid.Row="3" Grid.Column="2" Tag="SE" Cursor="SizeNWSE" Style="{StaticResource ResizeHandle}" />
    </Grid>
</Window>
