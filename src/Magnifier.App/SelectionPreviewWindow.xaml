<Window x:Class="Magnifier.App.SelectionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="확대 렌즈" Width="760" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        PreviewKeyDown="SelectionPreviewWindow_OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="#4798FF" BorderThickness="2" Background="#F3F6FC" CornerRadius="10">
        <Grid x:Name="LensLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Background="#183456">
                <Thumb x:Name="TitleThumb" Cursor="SizeAll" DragStarted="TitleThumb_OnDragStarted"
                       DragDelta="TitleThumb_OnDragDelta" DragCompleted="TitleThumb_OnDragCompleted"
                       LostMouseCapture="TitleThumb_OnLostMouseCapture"
                       AutomationProperties.Name="확대 렌즈 이동 손잡이">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="White" FontSize="15"
                           IsHitTestVisible="False" Text="확대 렌즈 · 이 제목부를 잡아 이동" />
            </Grid>
            <WrapPanel x:Name="Toolbar" Grid.Row="1" Margin="5">
                <Button x:Name="StartInputButton" Content="조작 시작" Click="StartInput_OnClick" Background="#D9EAFE" />
                <Button x:Name="StopInputButton" Content="조작 중지" Click="StopInput_OnClick" />
                <Button Content="원래 화면" Click="Return_OnClick" Background="#FFE8BC"
                        AutomationProperties.Name="입력을 해제하고 원래 화면으로 복귀" />
                <Button x:Name="ZoomDecreaseButton" Content="−" Click="ZoomDecrease_OnClick" MinWidth="42"
                        AutomationProperties.Name="배율 낮추기" />
                <TextBlock x:Name="ZoomText" MinWidth="62" VerticalAlignment="Center" TextAlignment="Center"
                           FontSize="16" FontWeight="SemiBold" Text="2×" />
                <Button x:Name="ZoomIncreaseButton" Content="+" Click="ZoomIncrease_OnClick" MinWidth="42"
                        AutomationProperties.Name="배율 높이기" />
            </WrapPanel>
            <Border x:Name="ImageBorder" Grid.Row="2" Margin="6,0" Background="#132033"
                    BorderBrush="#738DAE" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Image x:Name="CapturedImage" Stretch="Uniform" Cursor="Cross"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseLeftButtonDown="CapturedImage_OnMouseLeftButtonDown"
                           SizeChanged="CapturedImage_OnSizeChanged" />
                    <Canvas x:Name="PointMarkerLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Line x:Name="StraightStrokePreview" Stroke="#FDE047" StrokeThickness="3"
                              StrokeDashArray="5,3" Visibility="Collapsed" />
                        <Border x:Name="PointAMarker" Width="28" Height="28" Background="#D91D4ED8"
                                BorderBrush="White" BorderThickness="2" CornerRadius="14" Visibility="Collapsed">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Text="A" />
                        </Border>
                        <Border x:Name="PointBMarker" Width="28" Height="28" Background="#D904749C"
                                BorderBrush="White" BorderThickness="2" CornerRadius="14" Visibility="Collapsed">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Text="B" />
                        </Border>
                        <Grid x:Name="VirtualCursor" Width="26" Height="26" Visibility="Collapsed">
                            <Ellipse Margin="3" Stroke="#10243D" StrokeThickness="5" />
                            <Ellipse Margin="3" Stroke="#FDE047" StrokeThickness="2" />
                            <Line X1="13" X2="13" Y1="0" Y2="26" Stroke="White" StrokeThickness="1" />
                            <Line X1="0" X2="26" Y1="13" Y2="13" Stroke="White" StrokeThickness="1" />
                        </Grid>
                    </Canvas>
                    <TextBlock x:Name="EmptyImageText" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="White" Text="원본 화면을 기다리는 중입니다" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <StackPanel x:Name="StatusPanel" Grid.Row="3" Margin="12,6">
                <TextBlock x:Name="InputStatusText" FontSize="14" Foreground="#754000"
                           Text="보기 · 실제 입력 꺼짐" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CaptureStatusText" FontSize="12" Foreground="#40516A"
                           Text="조작 중 가장자리를 벗어나면 입력을 해제합니다" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectionBoundsText" FontSize="11" Foreground="#40516A" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Expander x:Name="AuxiliaryTools" Grid.Row="4" Margin="10,0,10,8"
                      Header="보조 도구 · A/B 직선" IsExpanded="False"
                      Expanded="AuxiliaryTools_OnExpanded" Collapsed="AuxiliaryTools_OnCollapsed">
                <StackPanel>
                    <WrapPanel x:Name="AuxiliaryControls">
                        <CheckBox x:Name="PreviewInputEnabledCheckBox" Margin="4" VerticalAlignment="Center"
                                  Checked="PreviewInputEnabledCheckBox_OnChanged" Unchecked="PreviewInputEnabledCheckBox_OnChanged"
                                  Content="A/B 실제 입력 허용" />
                        <Button Content="A 지정" Click="SelectPointA_OnClick" />
                        <Button Content="B 지정" Click="SelectPointB_OnClick" />
                        <Button Content="−" Click="CountdownDecrease_OnClick" AutomationProperties.Name="카운트다운 감소" />
                        <TextBlock x:Name="CountdownText" Text="3초" VerticalAlignment="Center" />
                        <Button Content="+" Click="CountdownIncrease_OnClick" AutomationProperties.Name="카운트다운 증가" />
                        <Button x:Name="RunStraightStrokeButton" Content="실제 A → B 실행" Click="RunStraightStroke_OnClick" />
                    </WrapPanel>
                    <TextBlock x:Name="PointStatusText" Margin="4" FontSize="12" Text="A와 B를 지정하세요" />
                </StackPanel>
            </Expander>
        </Grid>
    </Border>
</Window>
