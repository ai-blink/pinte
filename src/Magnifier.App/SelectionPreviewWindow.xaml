<Window x:Class="Magnifier.App.SelectionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="선택 영역 미리보기"
        Width="1280"
        Height="960"
        MinWidth="1080"
        MinHeight="800"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        PreviewKeyDown="SelectionPreviewWindow_OnPreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#182235"
                       Text="선택한 영역" />
            <TextBlock x:Name="SelectionBoundsText"
                       Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="#40516A"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="선택 영역의 화면 좌표"
                       Text="영역을 선택하는 중입니다" />
            <TextBlock x:Name="InputStatusText"
                       Grid.Column="2"
                       MaxWidth="360"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#8A4B00"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="실제 포인터 입력 상태"
                       Text="실제 포인터 입력: 꺼짐" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,8"
                Padding="6"
                Background="#101C30"
                BorderBrush="#3B82F6"
                BorderThickness="2"
                CornerRadius="12">
            <Grid>
                <Image x:Name="CapturedImage"
                       Stretch="Uniform"
                       Cursor="Cross"
                       MouseLeftButtonDown="CapturedImage_OnMouseLeftButtonDown"
                       MouseMove="CapturedImage_OnMouseMove"
                       MouseLeftButtonUp="CapturedImage_OnMouseLeftButtonUp"
                       LostMouseCapture="CapturedImage_OnLostMouseCapture" />
                <Border Margin="12"
                        Padding="9,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#CC2A3850"
                        CornerRadius="7"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="CaptureStatusText"
                               FontSize="13"
                               Foreground="#DCEBFF"
                               Text="화면 캡처는 아직 연결하지 않았습니다" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#182235"
                           Text="A→B" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#40516A"
                           Text="대기" />
                <RepeatButton MinWidth="36"
                              MinHeight="34"
                              Margin="6,0,0,0"
                              Padding="7,3"
                              Click="CountdownDecrease_OnClick"
                              Content="−"
                              Delay="500"
                              Interval="120"
                              FontSize="14"
                              FontWeight="SemiBold"
                              AutomationProperties.Name="카운트다운 감소" />
                <TextBlock x:Name="CountdownText"
                           MinWidth="42"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#182235"
                           TextAlignment="Center"
                           Text="3초" />
                <RepeatButton MinWidth="36"
                              MinHeight="34"
                              Padding="7,3"
                              Click="CountdownIncrease_OnClick"
                              Content="+"
                              Delay="500"
                              Interval="120"
                              FontSize="14"
                              FontWeight="SemiBold"
                              AutomationProperties.Name="카운트다운 증가" />
            </StackPanel>
            <TextBlock x:Name="PointStatusText"
                       Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#40516A"
                       TextTrimming="CharacterEllipsis"
                       Text="A와 B를 지정하세요" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button MinWidth="68"
                        MinHeight="34"
                        Padding="9,4"
                        Click="SelectPointA_OnClick"
                        Content="A 지정"
                        FontSize="13"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="A 지점 지정" />
                <Button MinWidth="68"
                        MinHeight="34"
                        Margin="6,0,0,0"
                        Padding="9,4"
                        Click="SelectPointB_OnClick"
                        Content="B 지정"
                        FontSize="13"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="B 지점 지정" />
                <Button x:Name="RunStraightStrokeButton"
                        MinWidth="100"
                        MinHeight="34"
                        Margin="6,0,0,0"
                        Padding="9,4"
                        Click="RunStraightStroke_OnClick"
                        Content="A → B 실행"
                        FontSize="13"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="A에서 B로 직선 획 실행" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   FontSize="12"
                   Foreground="#5A6B84"
                   TextWrapping="Wrap"
                   Text="창 제목 표시줄로 이동하고, 창 모서리 또는 오른쪽 아래 그립으로 크기를 조절할 수 있습니다. Esc는 카운트다운과 진행 중인 입력을 취소합니다." />
    </Grid>
</Window>
