<Window x:Class="Magnifier.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinte 설정" Width="760" Height="520" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="SettingsWindow_OnPreviewKeyDown"
        Background="{DynamicResource AppSurfaceBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="16">
        <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,1,0" CornerRadius="14,0,0,14" Padding="12">
                    <DockPanel LastChildFill="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8,8,8,22">
                                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AppAccentBrush}" Margin="0,0,9,0">
                                    <TextBlock Text="⌕" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" FontSize="15" Text="PINTE" />
                                    <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10" Text="화면 설정" />
                                </StackPanel>
                            </StackPanel>
                            <RadioButton x:Name="AppearancePageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="▦   화면" Checked="AppearancePage_OnClick" />
                            <RadioButton x:Name="DefaultsPageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="⌗   영역 · 배율" Checked="DefaultsPage_OnClick" />
                            <RadioButton x:Name="AdvancedPageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="⚙   고급" Checked="AdvancedPage_OnClick" />
                            <RadioButton x:Name="AboutPageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="ⓘ   앱 정보" Checked="AboutPage_OnClick" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="8" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                                   FontSize="11" LineHeight="17" Text="도구는 가볍게.&#x0a;화면은 편안하게." />
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="28,24,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel x:Name="AppearancePanel">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="화면" />
                                <TextBlock Margin="0,7,0,22" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="익숙한 배치와 편안한 색상을 선택하세요." />
                                <TextBlock FontWeight="SemiBold" Text="렌즈 보기" />
                                <ComboBox x:Name="LensDisplayModeBox" Style="{StaticResource AppComboBoxStyle}" MinHeight="30" Margin="0,8,0,18"
                                          SelectionChanged="LensDisplayMode_OnChanged" AutomationProperties.Name="렌즈 보기">
                                    <ComboBoxItem>일반 · 제목과 보조 도구</ComboBoxItem>
                                    <ComboBoxItem>컴팩트 · 이미지와 필수 도구</ComboBoxItem>
                                </ComboBox>
                                <TextBlock FontWeight="SemiBold" Text="확대 중 원본 영역 표시" />
                                <ComboBox x:Name="SourceIndicatorBox" Style="{StaticResource AppComboBoxStyle}" MinHeight="30" Margin="0,8,0,6"
                                          SelectionChanged="SourceIndicator_OnChanged" AutomationProperties.Name="확대 중 원본 영역 표시">
                                    <ComboBoxItem>숨김 · 기본값</ComboBoxItem>
                                    <ComboBoxItem>5초 · 얇은 윤곽선</ComboBoxItem>
                                    <ComboBoxItem>항상 · 얇은 윤곽선</ComboBoxItem>
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="윤곽선은 원본 클릭을 가로채지 않습니다. 영역을 바꾸려면 렌즈의 영역 편집을 누르세요." />
                                <TextBlock FontWeight="SemiBold" Text="화면 캡처 숨김" />
                                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12,4" Margin="0,8,0,18">
                                    <StackPanel>
                                        <CheckBox x:Name="HideAppWindowsFromScreenCaptureBox" MinHeight="44" VerticalContentAlignment="Center"
                                                  Content="앱 창을 화면 캡처에서 숨기기"
                                                  Checked="HideAppWindowsFromScreenCapture_OnChanged"
                                                  Unchecked="HideAppWindowsFromScreenCapture_OnChanged"
                                                  AutomationProperties.Name="앱 창 화면 캡처 숨기기" />
                                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="기본값은 꺼짐입니다. 켜면 렌즈와 보조 창이 다른 화면 캡처·녹화에 나타나지 않습니다." />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="ResizeLensButton" HorizontalAlignment="Left" MinHeight="44" Margin="0,0,0,18"
                                        Content="렌즈 크기 조절" Click="ResizeLens_OnClick" AutomationProperties.Name="큰 렌즈 크기 조절 손잡이 열기" />
                                <TextBlock FontWeight="SemiBold" Text="도구막대 배치 · 일반·컴팩트 공통" />
                                <WrapPanel Margin="0,10,0,24">
                                    <RadioButton x:Name="TopToolbarButton" GroupName="ToolbarPlacement" Style="{StaticResource LayoutChoiceStyle}"
                                                 Checked="ToolbarPlacement_OnChanged">
                                        <StackPanel>
                                            <Border Height="26" CornerRadius="5" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                <Border Height="7" VerticalAlignment="Top" Margin="4" CornerRadius="3" Background="{DynamicResource AppAccentSoftBrush}" />
                                            </Border>
                                            <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="상단 도구막대" />
                                            <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Text="렌즈 위쪽에 고정" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="BottomToolbarButton" GroupName="ToolbarPlacement" Style="{StaticResource LayoutChoiceStyle}"
                                                 Checked="ToolbarPlacement_OnChanged" Margin="0">
                                        <StackPanel>
                                            <Border Height="26" CornerRadius="5" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                <Border Height="7" VerticalAlignment="Bottom" Margin="4" CornerRadius="3" Background="{DynamicResource AppAccentSoftBrush}" />
                                            </Border>
                                            <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="하단 도구막대" />
                                            <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Text="콘텐츠 아래에 고정" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBlock FontWeight="SemiBold" Text="테마" />
                                <TextBlock Margin="0,5,0,8" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="창과 도구막대의 밝기를 즉시 바꿉니다." />
                                <ComboBox x:Name="ThemeBox" Style="{StaticResource AppComboBoxStyle}" Width="210" MinHeight="30"
                                          SelectionChanged="ThemeBox_OnSelectionChanged" AutomationProperties.Name="앱 테마">
                                    <ComboBoxItem Tag="System">시스템 설정</ComboBoxItem>
                                    <ComboBoxItem Tag="Light">밝게</ComboBoxItem>
                                    <ComboBoxItem Tag="Dark">어둡게</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="DefaultsPanel" Visibility="Collapsed">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="영역 · 배율" />
                                <TextBlock Margin="0,7,0,22" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="다음에 확대를 시작할 때 사용할 값을 정합니다." />
                                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="이전 영역과 배율 기억" />
                                        <TextBlock Margin="0,4,0,6" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="마지막 영역·배율·배치를 다음 실행에도 사용합니다." />
                                        <CheckBox x:Name="RememberLayoutBox" MinHeight="44" VerticalContentAlignment="Center"
                                                  Content="이전 값 기억" Checked="RememberLayout_OnChanged" Unchecked="RememberLayout_OnChanged"
                                                  AutomationProperties.Name="이전 영역과 배율 기억" />
                                    </StackPanel>
                                </Border>
                                <TextBlock FontWeight="SemiBold" Text="기본 원본 영역 크기" />
                                <TextBlock Margin="0,5,0,8" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" Text="다음 영역 지정의 시작 크기입니다." />
                                <ComboBox x:Name="DefaultSizeBox" Style="{StaticResource AppComboBoxStyle}" Width="220" MinHeight="30" Margin="0,0,0,18"
                                          SelectionChanged="DefaultSizeBox_OnSelectionChanged" AutomationProperties.Name="기본 원본 영역 크기" />
                                <TextBlock FontWeight="SemiBold" Text="기본 확대 배율" />
                                <TextBlock Margin="0,5,0,8" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" Text="원본 영역과 별도로 적용됩니다." />
                                <ComboBox x:Name="DefaultZoomBox" Style="{StaticResource AppComboBoxStyle}" Width="160" MinHeight="30"
                                          SelectionChanged="DefaultZoomBox_OnSelectionChanged" AutomationProperties.Name="기본 확대 배율" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="이전 값 기억을 켠 상태에서도 기본값을 미리 바꿀 수 있습니다. 다음에 기억 기능을 끄고 확대할 때 적용됩니다." />
                            </StackPanel>

                            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="고급" />
                                <TextBlock Margin="0,7,0,22" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="시스템 사양·게임·앱에 따라 알맞은 값이 다릅니다. 클릭이 누락되면 값을 늘리고, 느리면 줄이세요." />
                                <TextBlock FontWeight="SemiBold" Text="입력 전달 타이밍" />
                                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,18">
                                    <StackPanel>
                                        <TextBlock x:Name="TimingSummaryText" FontSize="13" />
                                        <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="도착 후 누르기 대기 / 최소 누름 유지 / 해제 후 체류 / 제스처 간격. 조절 창은 렌즈 위에 떠 있어 대상 앱에서 바로 비교할 수 있습니다." />
                                        <Button x:Name="InputTimingButton" HorizontalAlignment="Left" MinHeight="44" Content="입력 타이밍 조절 열기"
                                                Click="InputTiming_OnClick" AutomationProperties.Name="입력 전달 타이밍 조절 창 열기" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                                <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AppAccentSoftBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="⌕" Foreground="{DynamicResource AppAccentBrush}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,16,0,0" FontSize="24" FontWeight="SemiBold" Text="Magnifier" />
                                <TextBlock Margin="0,7,0,22" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="원하는 곳을 크게 보고, 마우스로 편하게 조작하세요." />
                                <TextBlock FontWeight="SemiBold" Text="간단한 사용법" />
                                <Border Margin="0,9,0,18" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14">
                                    <TextBlock TextWrapping="Wrap" LineHeight="23"
                                               Text="1. 원본 테두리를 옮기고 손잡이로 크기를 맞춥니다.&#x0a;2. 확대 렌즈에서 평소처럼 클릭하고 드래그합니다.&#x0a;3. 도구막대의 원래 화면으로 언제든 돌아옵니다." />
                                </Border>
                                <TextBlock x:Name="VersionText" Margin="0,0,0,12" Foreground="{DynamicResource AppMutedTextBrush}" />
                                <Button HorizontalAlignment="Left" MinHeight="44" Content="진단 로그 폴더 열기" Click="OpenDiagnostics_OnClick"
                                        AutomationProperties.Name="진단 로그 폴더 열기" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="0,18,0,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Button HorizontalAlignment="Right" Style="{StaticResource SoftAccentButtonStyle}" Content="닫기" Click="Close_OnClick"
                                AutomationProperties.Name="앱 설정 닫기" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
