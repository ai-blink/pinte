<Window x:Class="Magnifier.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Magnifier.App.Localization"
        Title="{loc:Tr SettingsTitle}" Width="760" Height="520" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="SettingsWindow_OnPreviewKeyDown"
        Background="{DynamicResource AppSurfaceBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="16">
        <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,1,0" CornerRadius="14,0,0,14" Padding="12">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="8,8,8,22">
                                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AppAccentBrush}" Margin="0,0,9,0">
                                    <TextBlock Text="⌕" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" FontSize="15" Text="PINTE" />
                                    <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10" Text="{loc:Tr Nav_Subtitle}" />
                                </StackPanel>
                            </StackPanel>
                            <RadioButton x:Name="AppearancePageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="{loc:Tr Nav_Appearance}" Checked="AppearancePage_OnClick" />
                            <RadioButton x:Name="DefaultsPageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="{loc:Tr Nav_Defaults}" Checked="DefaultsPage_OnClick" />
                            <RadioButton x:Name="AdvancedPageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="{loc:Tr Nav_Advanced}" Checked="AdvancedPage_OnClick" />
                            <RadioButton x:Name="AboutPageButton" Style="{StaticResource SettingsNavigationStyle}"
                                         Content="{loc:Tr Nav_About}" Checked="AboutPage_OnClick" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="8" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                                   FontSize="11" LineHeight="17" Text="{loc:Tr Nav_Tagline}" />
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="28,24,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,14,0">
                            <StackPanel x:Name="AppearancePanel">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Tr Appearance_Title}" />
                                <TextBlock Margin="0,7,0,22" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr Appearance_Subtitle}" />
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr Language_Label}" />
                                <TextBlock Margin="0,5,0,8" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr Language_Hint}" />
                                <ComboBox x:Name="LanguageBox" Style="{StaticResource AppComboBoxStyle}" HorizontalAlignment="Left" MinWidth="120" MinHeight="30" Margin="0,0,0,18"
                                          SelectionChanged="LanguageBox_OnSelectionChanged" AutomationProperties.Name="{loc:Tr Language_Automation}">
                                    <ComboBoxItem Content="{loc:Tr Language_System}" />
                                    <ComboBoxItem Content="{loc:Tr Language_NameKo}" />
                                    <ComboBoxItem Content="{loc:Tr Language_NameEn}" />
                                    <ComboBoxItem Content="{loc:Tr Language_NameZhHans}" />
                                    <ComboBoxItem Content="{loc:Tr Language_NameJa}" />
                                </ComboBox>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr LensDisplay_Label}" />
                                <ComboBox x:Name="LensDisplayModeBox" Style="{StaticResource AppComboBoxStyle}" MinHeight="30" Margin="0,8,0,18"
                                          SelectionChanged="LensDisplayMode_OnChanged" AutomationProperties.Name="{loc:Tr LensDisplay_Label}">
                                    <ComboBoxItem Content="{loc:Tr LensMode_Normal}" />
                                    <ComboBoxItem Content="{loc:Tr LensMode_Compact}" />
                                </ComboBox>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr SourceIndicator_Label}" />
                                <ComboBox x:Name="SourceIndicatorBox" Style="{StaticResource AppComboBoxStyle}" MinHeight="30" Margin="0,8,0,6"
                                          SelectionChanged="SourceIndicator_OnChanged" AutomationProperties.Name="{loc:Tr SourceIndicator_Label}">
                                    <ComboBoxItem Content="{loc:Tr SourceIndicator_Hidden}" />
                                    <ComboBoxItem Content="{loc:Tr SourceIndicator_Brief}" />
                                    <ComboBoxItem Content="{loc:Tr SourceIndicator_Always}" />
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr SourceIndicator_Hint}" />
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr Capture_Label}" />
                                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12,4" Margin="0,8,0,18">
                                    <StackPanel>
                                        <CheckBox x:Name="HideAppWindowsFromScreenCaptureBox" MinHeight="44" VerticalContentAlignment="Center"
                                                  Content="{loc:Tr Capture_CheckboxLabel}"
                                                  Checked="HideAppWindowsFromScreenCapture_OnChanged"
                                                  Unchecked="HideAppWindowsFromScreenCapture_OnChanged"
                                                  AutomationProperties.Name="{loc:Tr Capture_CheckboxLabel}" />
                                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="{loc:Tr Capture_Hint}" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="ResizeLensButton" HorizontalAlignment="Left" MinHeight="44" Margin="0,0,0,18"
                                        Content="{loc:Tr ResizeLens_Button}" Click="ResizeLens_OnClick" AutomationProperties.Name="{loc:Tr ResizeLens_Automation}" />
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr ToolbarPlacement_Label}" />
                                <WrapPanel Margin="0,10,0,24">
                                    <RadioButton x:Name="TopToolbarButton" GroupName="ToolbarPlacement" Style="{StaticResource LayoutChoiceStyle}"
                                                 Checked="ToolbarPlacement_OnChanged">
                                        <StackPanel>
                                            <Border Height="26" CornerRadius="5" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                <Border Height="7" VerticalAlignment="Top" Margin="4" CornerRadius="3" Background="{DynamicResource AppAccentSoftBrush}" />
                                            </Border>
                                            <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="{loc:Tr ToolbarPlacement_Top}" />
                                            <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Text="{loc:Tr ToolbarPlacement_TopHint}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="BottomToolbarButton" GroupName="ToolbarPlacement" Style="{StaticResource LayoutChoiceStyle}"
                                                 Checked="ToolbarPlacement_OnChanged" Margin="0">
                                        <StackPanel>
                                            <Border Height="26" CornerRadius="5" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                <Border Height="7" VerticalAlignment="Bottom" Margin="4" CornerRadius="3" Background="{DynamicResource AppAccentSoftBrush}" />
                                            </Border>
                                            <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="{loc:Tr ToolbarPlacement_Bottom}" />
                                            <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Text="{loc:Tr ToolbarPlacement_BottomHint}" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr Theme_Label}" />
                                <TextBlock Margin="0,5,0,8" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr Theme_Hint}" />
                                <ComboBox x:Name="ThemeBox" Style="{StaticResource AppComboBoxStyle}" HorizontalAlignment="Left" MinWidth="120" MinHeight="30"
                                          SelectionChanged="ThemeBox_OnSelectionChanged" AutomationProperties.Name="{loc:Tr Theme_Automation}">
                                    <ComboBoxItem Tag="System" Content="{loc:Tr Theme_System}" />
                                    <ComboBoxItem Tag="Light" Content="{loc:Tr Theme_Light}" />
                                    <ComboBoxItem Tag="Dark" Content="{loc:Tr Theme_Dark}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="DefaultsPanel" Visibility="Collapsed">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Tr Defaults_Title}" />
                                <TextBlock Margin="0,7,0,22" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr Defaults_Subtitle}" />
                                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{loc:Tr RememberLayout_Label}" />
                                        <TextBlock Margin="0,4,0,6" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="{loc:Tr RememberLayout_Hint}" />
                                        <CheckBox x:Name="RememberLayoutBox" MinHeight="44" VerticalContentAlignment="Center"
                                                  Content="{loc:Tr RememberLayout_Checkbox}" Checked="RememberLayout_OnChanged" Unchecked="RememberLayout_OnChanged"
                                                  AutomationProperties.Name="{loc:Tr RememberLayout_Label}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr DefaultSize_Label}" />
                                <TextBlock Margin="0,5,0,8" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" Text="{loc:Tr DefaultSize_Hint}" />
                                <ComboBox x:Name="DefaultSizeBox" Style="{StaticResource AppComboBoxStyle}" HorizontalAlignment="Left" Width="220" MinHeight="30" Margin="0,0,0,18"
                                          SelectionChanged="DefaultSizeBox_OnSelectionChanged" AutomationProperties.Name="{loc:Tr DefaultSize_Label}" />
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr DefaultZoom_Label}" />
                                <TextBlock Margin="0,5,0,8" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" Text="{loc:Tr DefaultZoom_Hint}" />
                                <ComboBox x:Name="DefaultZoomBox" Style="{StaticResource AppComboBoxStyle}" HorizontalAlignment="Left" Width="160" MinHeight="30"
                                          SelectionChanged="DefaultZoomBox_OnSelectionChanged" AutomationProperties.Name="{loc:Tr DefaultZoom_Label}" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr Defaults_Footnote}" />
                            </StackPanel>

                            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Tr Advanced_Title}" />
                                <TextBlock Margin="0,7,0,22" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr Advanced_Subtitle}" />
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr Timing_Label}" />
                                <Border Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,18">
                                    <StackPanel>
                                        <TextBlock x:Name="TimingSummaryText" FontSize="13" />
                                        <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="{loc:Tr Timing_Hint}" />
                                        <Button x:Name="InputTimingButton" HorizontalAlignment="Left" MinHeight="44" Content="{loc:Tr Timing_OpenButton}"
                                                Click="InputTiming_OnClick" AutomationProperties.Name="{loc:Tr Timing_OpenAutomation}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                                <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AppAccentSoftBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="⌕" Foreground="{DynamicResource AppAccentBrush}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,16,0,0" FontSize="24" FontWeight="SemiBold" Text="Magnifier" />
                                <TextBlock Margin="0,7,0,22" Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{loc:Tr About_Subtitle}" />
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr About_HowToLabel}" />
                                <Border Margin="0,9,0,18" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14">
                                    <TextBlock TextWrapping="Wrap" LineHeight="23"
                                               Text="{loc:Tr About_HowToSteps}" />
                                </Border>
                                <TextBlock x:Name="VersionText" Margin="0,0,0,12" Foreground="{DynamicResource AppMutedTextBrush}" />
                                <Button HorizontalAlignment="Left" MinHeight="44" Content="{loc:Tr About_DiagnosticsButton}" Click="OpenDiagnostics_OnClick"
                                        AutomationProperties.Name="{loc:Tr About_DiagnosticsButton}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="0,18,0,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Button HorizontalAlignment="Right" Style="{StaticResource SoftAccentButtonStyle}" Content="{loc:Tr Common_Close}" Click="Close_OnClick"
                                AutomationProperties.Name="{loc:Tr Close_Automation}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
